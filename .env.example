# ── Zerodha Kite Connect ──────────────────────────────────────────────────────
# Create app at: https://developers.kite.trade/apps
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=
# Access token is auto-saved to .kite_token.json after running: python kite_login.py

# ── AI Provider ───────────────────────────────────────────────────────────────
# OpenAI (priority if both set): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude (fallback): https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=

# Model for pre-market day classification (runs once, use smarter model)
AI_MODEL_DAY=gpt-4o

# Model for signal generation (runs every 5 min, use fast/cheap model)
AI_MODEL_SIGNAL=gpt-4o-mini

# ── Supabase Database ─────────────────────────────────────────────────────────
# Create project at: https://supabase.com/dashboard
# Then run: python migrate.py --token YOUR_PERSONAL_ACCESS_TOKEN
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_publishable_key

# Direct DB connection (optional — only works with IPv4 add-on or local Supabase)
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# ── Bot Settings ──────────────────────────────────────────────────────────────
TRADING_MODE=paper          # paper = safe simulation | live = real money
PORTFOLIO_VALUE=100000      # virtual portfolio in INR for paper trading

# Risk management
MAX_RISK_PER_TRADE=2.0      # max % of portfolio risked per trade
MAX_DAILY_DRAWDOWN=6.0      # circuit breaker fires if daily loss hits this %
MAX_POSITIONS=5             # max concurrent open positions
MIN_RR_RATIO=2.0            # minimum risk:reward — signals below this are rejected
SQUAREOFF_TIME=15:20        # auto square-off all positions at this time (IST)

# ── Options Settings ──────────────────────────────────────────────────────────
# Buy-side index options only (NIFTY / BANKNIFTY CE + PE)
MAX_IV_RANK=40.0            # skip buying when IV rank > this (expensive premium)
MIN_DTE=4                   # skip options expiring within this many days
OPTION_STOP_LOSS_PCT=50.0   # exit if premium drops this % from entry
OPTION_TARGET_MULTIPLIER=2.0  # target = entry premium × this
MAX_PREMIUM_PCT=1.5         # max option premium as % of portfolio per trade

# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING
